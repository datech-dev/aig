# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Venice.ai API key and configuration
VENICE_API_KEY=your_venice_api_key_here
VENICE_MODEL=dolphin-2.9.2-qwen2-72b
VENICE_IMAGE_MODEL=lustify-sdxl

# Razorpay API Credentials
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
# Admin Telegram ID to access the /stats command securely
ADMIN_TELEGRAM_ID=your_telegram_id_here

# Sarvam.ai Voice AI (Saaras v4 STT & Bulbul v4 TTS)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_SPEAKER=ishita_enhi_companion
